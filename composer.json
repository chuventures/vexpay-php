{
    "name": "vexpay/vexpay-php",
    "description": "Official PHP server SDK for the VEXPay payments API (Venezuela): C2P, card, Pago Móvil, checkout sessions, merchants, payouts and signed webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["vexpay", "payments", "venezuela", "pago movil", "c2p", "checkout", "webhooks", "sdk"],
    "homepage": "https://github.com/chuventures/vexpay-php",
    "support": {
        "issues": "https://github.com/chuventures/vexpay-php/issues",
        "source": "https://github.com/chuventures/vexpay-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "VexPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VexPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
